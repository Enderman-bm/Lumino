<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Lumino.Views.Dialogs.PreloadMidiDialog"
    xmlns:vm="using:Lumino.ViewModels.Dialogs"
    xmlns:converters="using:Lumino.Views.Converters"
    x:DataType="vm:PreloadMidiViewModel"
    Title="预加载 MIDI"
    Width="520"
    Height="220"
    WindowStartupLocation="CenterOwner"
    CanResize="False"
    ShowInTaskbar="False"
    Topmost="True">

    <Border Name="RootBorder" CornerRadius="8" Padding="12" Margin="8" Background="{Binding BackgroundBrush}" Opacity="{Binding Opacity}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <!-- small icon -->
                <TextBlock Text="🎵" FontSize="18" VerticalAlignment="Center"/>
                <TextBlock Text="准备加载 MIDI 文件" FontSize="18" FontWeight="Bold" Margin="4" />
            </StackPanel>

            <!-- 主内容面板（文件信息） -->
            <StackPanel x:Name="ContentPanel" Grid.Row="1" Margin="4" Spacing="8" Opacity="1" IsVisible="{Binding IsStarting, Converter={x:Static converters:NotConverter.Instance}}">
                <TextBlock Text="文件：" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>

                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                    <TextBlock Text="大小：" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding FileSizeText}" />
                    <!-- simple loading icon -->
                    <Border Width="16" Height="16" CornerRadius="8" Background="Transparent" HorizontalAlignment="Left" Margin="12,0,0,0">
                        <Rectangle x:Name="LoadingRect" Width="12" Height="12" Fill="{DynamicResource ButtonActiveBrush}">
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="{Binding RotationAngle}"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Border>
                </StackPanel>

                <TextBlock Text="请选择接下来的操作：取消 — 不加载；重新选择 — 选择其他文件；加载 — 开始加载当前文件。" TextWrapping="Wrap" Opacity="0.9"/>
            </StackPanel>

            <!-- 启动进度面板（在按下加载后可见） -->
            <StackPanel x:Name="ProgressPanel" Grid.Row="1" Margin="4" Spacing="8" IsVisible="{Binding IsStarting}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="启动中..." FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>

                <!-- 进度环/占位：保留圆形背景并在内部放置进度条 -->
                <Border Width="320" Height="72" CornerRadius="8" Background="{DynamicResource FlyoutBackgroundBrush}" Opacity="0.95" Padding="8">
                    <Grid>
                        <!-- Determinate progress (normal) -->
                        <StackPanel Orientation="Vertical" Spacing="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" IsVisible="{Binding IsIndeterminate, Converter={x:Static converters:NotConverter.Instance}}">
                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="10" HorizontalAlignment="Stretch" />
                            <TextBlock Text="{Binding StatusText}" FontSize="12" Opacity="0.95" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Indeterminate / Android-like horizontal loading animation -->
                        <StackPanel Orientation="Vertical" Spacing="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" IsVisible="{Binding IsIndeterminate}">
                            <!-- 使用 Avalonia 的不确定进度条来模拟安卓横向加载动画 -->
                            <ProgressBar IsIndeterminate="True" Height="6" HorizontalAlignment="Stretch" />
                            <TextBlock Text="{Binding StatusText}" FontSize="12" Opacity="0.95" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
            

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
                <Button x:Name="CancelButton" Classes="DialogButton Secondary" Content="取消" Command="{Binding CancelCommand}"/>
                <Button x:Name="ReselectButton" Classes="DialogButton" Content="重新选择" Command="{Binding ReselectCommand}"/>
                <Button x:Name="LoadButton" Classes="DialogButton Primary" Content="加载" Command="{Binding LoadCommand}" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
